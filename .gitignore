# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# Repo-root .env files. Anchored with a leading slash on purpose:
# functions/.env and functions/.env.cluttrd-staging are TRACKED, functional
# deploy config ("Loaded environment variables from .env,
# .env.cluttrd-staging" on every firebase deploy), so a bare `.env*` pattern
# here would be wrong. This closes the root gap only, which is where a
# credential would land if someone dropped one next to package.json.
/.env
/.env.*
!/.env.example

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
