rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // analysisCount/analysisCountMonth are permanently server-owned (written
      // only by the Admin SDK inside analyzePhoto's transaction). A client
      // create must not seed a nonzero/rollover-primed value for itself.
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('analysisCount' in request.resource.data) || request.resource.data.analysisCount == 0)
        && !('analysisCountMonth' in request.resource.data);

      // Client updates may only ever touch isPro (temporary, pending the
      // RevenueCat-webhook migration in BACKLOG.md) or hasSeenTutorial
      // (DecisionLog.md 2026-07-18 - Firestore is now the source of truth
      // for onboarding-completion, AsyncStorage is just a local cache) -
      // this alone guarantees analysisCount/analysisCountMonth can't be
      // touched by any client write, no separate equality check needed.
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPro', 'hasSeenTutorial']);

      // NOT tightened per the flagged conflict: blocking delete here would
      // break the existing client-side account deletion flow (deleteDoc while
      // still authenticated - see DecisionLog.md). Left as-is pending a
      // decision on moving account deletion server-side.
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /plans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Server (Admin SDK) only - Admin SDK bypasses rules entirely, so this
      // is purely a statement of intent: no client ever has a legitimate
      // reason to read or write its own idempotency records directly.
      match /analysisIdempotency/{analysisId} {
        allow read, write: if false;
      }

      // Server (Admin SDK) only - revenueCatWebhook's idempotency records
      // (DecisionLog.md 2026-07-21), same reasoning as analysisIdempotency
      // above. NOT yet touching `isPro`'s client-write access above -
      // that's the last step of the migration, only once the webhook is
      // verified working end-to-end (BACKLOG.md).
      match /revenueCatWebhookEvents/{eventId} {
        allow read, write: if false;
      }
    }

    // Server (Admin SDK) only - deletion-monitoring breadcrumbs written by
    // recordUserDocDeletion and read by checkOrphanedUserDeletions. No client
    // has a legitimate reason to read or write these directly.
    match /deletionAudit/{uid} {
      allow read, write: if false;
    }
  }
}
