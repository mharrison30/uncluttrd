rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;

      // A client may create ONLY its own profile document, and only with the
      // fields the app's signup path actually writes (App.js
      // ensureUserDocument: uid, email, displayName, createdAt, platform,
      // isPro, isTestAccount, plus referralSource/isNewSignup at signup).
      // Every one of these checks closes a real hole found by emulator audit:
      //
      // - uid must match the path, so the stored identity cannot be forged.
      // - isPro must be present and exactly false. It is server-owned (see the
      //   update rule), and without this a client could delete its document
      //   and recreate it with isPro: true.
      // - analysisCount/analysisCountMonth are permanently server-owned
      //   (written only by the Admin SDK inside analyzePhoto's transaction). A
      //   client create must not seed a nonzero/rollover-primed value.
      // - keys().hasOnly() denies any field outside the allowlist, so no new
      //   client-owned field can appear without a deliberate rule change.
      //   analysisCount stays on the list only as absent-or-zero, for
      //   compatibility with the check above.
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
             'uid', 'email', 'displayName', 'createdAt', 'platform', 'isPro',
             'isTestAccount', 'referralSource', 'isNewSignup', 'analysisCount'
           ])
        && ('isPro' in request.resource.data) && request.resource.data.isPro == false
        && (!('analysisCount' in request.resource.data) || request.resource.data.analysisCount == 0)
        && !('analysisCountMonth' in request.resource.data);

      // Client updates may only ever touch hasSeenTutorial (DecisionLog.md
      // 2026-07-18 - Firestore is now the source of truth for
      // onboarding-completion, AsyncStorage is just a local cache) - this
      // alone guarantees analysisCount/analysisCountMonth can't be touched
      // by any client write, no separate equality check needed.
      //
      // isPro was removed from this list 2026-08-15, completing the
      // RevenueCat-webhook migration. It is now server-owned: the sole
      // writer is revenueCatWebhook -> syncProStatus via the Admin SDK,
      // which re-queries RevenueCat's REST API rather than trusting the
      // event body. Previously any signed-in user could grant themselves
      // Pro with one updateDoc.
      //
      // Preconditions that had to hold before this line could change, all
      // verified - see RevenueCatHardeningImplementation.md:
      //   1. The webhook demonstrably writes isPro=true for a genuinely
      //      entitled customer (RENEWAL/TRANSFER, 2026-08-15).
      //   2. No client code path writes isPro any more (both updateDoc
      //      calls in App.js removed the same day).
      //   3. Server-side authorization no longer trusts the field -
      //      analyzePhoto and generateVisualization both call
      //      verifyProEntitlement.
      // Tightening this without (2) would have silently demoted paying
      // users on their next launch.
      //
      // Note the seed at signup is a CREATE (isPro: false), governed by the
      // allow create rule above, so it is unaffected by this restriction.
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasSeenTutorial']);

      // TEMPORARY - LEGACY CLIENT COMPATIBILITY. The current app never deletes
      // this document from the client: account deletion moved server-side to
      // the hardDeleteAccount callable in ec5d06e (2026-08-10). Owner delete
      // stays allowed only because 1.0.x builds still delete it client-side
      // (deleteDoc while authenticated), and denying it would break account
      // deletion for anyone still on those versions.
      //
      // Known cost: delete-then-recreate resets the server-owned monthly
      // usage counter (checkOrphanedUserDeletions logs it as a possible
      // free-plan bypass). The hardened create rule above still prevents
      // recreating with isPro: true or seeded usage. Restrict this to
      // `if false` once 1.0.x usage is confirmed gone.
      allow delete: if request.auth != null && request.auth.uid == userId;

      match /plans/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Space/Project/Session/Batch shadow structure (Space Implementation
      // Slice 1/2) - same ownership pattern as plans/{planId} above, applied
      // at every nesting level. Added 2026-08-02 after live testing showed
      // the shadow write (writeSpaceShadowStructure, App.js) was silently
      // denied for real authenticated clients with no rule present here.
      match /spaces/{spaceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Area Identity durable Area objects (AreaIdentityDesign.md §2) -
        // same ownership pattern as projects/sessions/batches below. Had
        // ZERO rule coverage until Phase B prerequisites (2026-08-09):
        // every real client read/write (createAreaForPlan, updateAreaSummary,
        // renameArea, Room Detail's loadRoomDetailAreas) was being silently
        // denied - Phase A's "43/43 passing" validation only ever exercised
        // the Admin SDK path, which bypasses rules entirely. Same failure
        // mode already documented once above for the shadow structure.
        match /areas/{areaId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
        match /projects/{projectId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
          match /sessions/{sessionId} {
            allow read, write: if request.auth != null && request.auth.uid == userId;
            match /batches/{batchId} {
              allow read, write: if request.auth != null && request.auth.uid == userId;
            }
          }
        }
      }

      // §12 Migration Part 2/3 merge candidates - same ownership pattern as
      // spaces/{spaceId} above. Previously had ZERO rule coverage (flagged
      // during Part 3 scoping, MergeProposalDesign.md) - only the Admin SDK
      // migration runner could touch this collection; a real authenticated
      // client would have been silently denied on both read and write, the
      // same failure mode already seen once for the shadow structure above.
      // Added ahead of the comparison/resolution UI (Part 3) so that work
      // is never blocked on a rules gap discovered late.
      match /mergeCandidates/{candidateId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        match /history/{eventId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Legacy Reclassification (LegacyReclassificationDesign.md) execution
      // tracking, keyed by planId - same ownership pattern as
      // mergeCandidates above. Same failure mode already seen twice this
      // project (shadow structure, areas): had zero rule coverage since it
      // was only ever exercised via the Admin-SDK CLI script
      // (scripts/reclassifyLegacyPlan.js) - added now that Room Rename's
      // "Move plans to [Room]" duplicate-name resolution calls the client-
      // SDK mirror of that same workflow directly from the app.
      match /reclassificationExecutions/{planId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Server (Admin SDK) only - Admin SDK bypasses rules entirely, so this
      // is purely a statement of intent: no client ever has a legitimate
      // reason to read or write its own idempotency records directly.
      match /analysisIdempotency/{analysisId} {
        allow read, write: if false;
      }

      // Server (Admin SDK) only - revenueCatWebhook's idempotency records
      // (DecisionLog.md 2026-07-21), same reasoning as analysisIdempotency
      // above. NOT yet touching `isPro`'s client-write access above -
      // that's the last step of the migration, only once the webhook is
      // verified working end-to-end (BACKLOG.md).
      match /revenueCatWebhookEvents/{eventId} {
        allow read, write: if false;
      }
    }

    // Server (Admin SDK) only - deletion-monitoring breadcrumbs written by
    // recordUserDocDeletion and read by checkOrphanedUserDeletions. No client
    // has a legitimate reason to read or write these directly.
    match /deletionAudit/{uid} {
      allow read, write: if false;
    }

    // App-wide, non-user config (e.g. config/appVersion, the soft
    // update-nudge's latest-released-version values - DecisionLog.md
    // 2026-07-30). Public read, since the update check runs on app launch
    // before a user may have signed in. Never client-writable - set only by
    // the developer (Firebase Console or an Admin SDK script) after each
    // release.
    match /config/{document} {
      allow read: if true;
      allow write: if false;
    }
  }
}
