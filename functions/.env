# Config for defineString() params in functions/index.js. Not secrets - use
# `firebase functions:secrets:set` for anything sensitive instead.

# Dedicated test account the analyzePhotoCanary scheduled function signs in
# as to exercise analyzePhoto's real authenticated path. Defaults to the
# account already flagged isTestAccount: true (and isPro: true, so canary
# runs never touch the free-plan count) in its own Firestore doc. Change
# this if a different dedicated canary account is preferred.
CANARY_TEST_UID=m4ecZ9B9B1XmDrOiAQfFPjdjyNB3

# Production's public, client-embedded Firebase Web API key - used only to
# exchange a custom token for a real ID token via the Identity Toolkit REST
# API inside analyzePhotoCanary. Not a secret. .env.cluttrd-staging
# overrides this with staging's own key for staging deploys.
CANARY_WEB_API_KEY=AIzaSyAvgaO7X_IyUDZbUrYGGB4k_tTV6TpQOl4

# RevenueCat project id (not a secret - an identifier, used in
# revenueCatWebhook's active_entitlements REST API URL). Not overridden in
# .env.cluttrd-staging - one RevenueCat project serves both production and
# iOS Staging apps (DecisionLog.md 2026-07-16), so this value is genuinely
# the same across environments, unlike CANARY_WEB_API_KEY above. Placed here
# (not just as the defineString default in code) because firebase deploy in
# non-interactive mode requires an .env-resolvable value regardless of the
# code-level default - confirmed empirically 2026-07-21, correcting the
# original assumption that a code default alone would be sufficient.
REVENUECAT_PROJECT_ID=projc4cb5734
